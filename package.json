{
  "name": "legalthink-workspace",
  "description": "Local document review for German legal work",
  "license": "MIT",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix frontend run build",
    "test:api": "node scripts/test-api.mjs",
    "test:built": "playwright test",
    "format": "prettier --write frontend/src frontend/*.ts tests scripts *.ts *.json",
    "format:check": "prettier --check frontend/src frontend/*.ts tests scripts *.ts *.json"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.10.0"
  }
}
