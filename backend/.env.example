# Server-only credential. Never put this in a VITE_ variable.
OPENAI_API_KEY=

# Analysis default: gpt-6-luna with reasoning effort high.
# Model and effort are selected per request in the UI, not through environment variables.

# Optional; defaults to backend/data. Local SQLite content is not encrypted.
# LEGALTHINK_DATA_DIR=

# Personal workspace: keep loopback binding. Remote mode requires TLS at the proxy,
# explicit hosts/origins, and a bearer token of at least 32 characters.
LEGALTHINK_ALLOW_REMOTE=false
# LEGALTHINK_API_TOKEN=
# LEGALTHINK_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# LEGALTHINK_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,http://localhost:8000,http://127.0.0.1:8000
